<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/fitplan_widget_background" android:orientation="vertical"
 android:padding="11dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#66FF91" android:textStyle="bold" android:textSize="16sp" android:text="FitPlan"/>
  <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8FFF1" android:textSize="11sp" android:text="완료 0일"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C6D8D1" android:textSize="11sp" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:text="운동 일정"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="일" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="월" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="화" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="수" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="목" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="금" android:textColor="#9AB0AB" android:textSize="10sp"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="토" android:textColor="#9AB0AB" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>